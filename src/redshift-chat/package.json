{
  "name": "redshift-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node dist/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@azure/ai-projects": "2.9.0",
    "@azure/identity": "4.14.0",
    "@azure/logger": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
